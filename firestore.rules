rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /suggestions/{id} {
      // Anyone with the site can read and add suggestions; nothing can be edited or deleted from the site.
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text', 'dateKey', 'bypass', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 400
                    && request.resource.data.dateKey is string
                    && request.resource.data.bypass is bool;
      allow update, delete: if false;
    }
  }
}
